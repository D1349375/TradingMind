# TradeMind — 環境變數範本
# 複製成 .env.local 後填入真實值。.env.local 已在 .gitignore,不會被 commit。

# ---- Supabase(Postgres + Auth) ----
# 到 supabase.com 建一個免費專案後,在 Project Settings → Database 拿連線字串
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Bybit API 加密金鑰 ----
# 用來加密使用者填入的 Bybit 唯讀 API Key/Secret(AES-256-GCM),不是 Bybit 本身的金鑰
# 產生方式:openssl rand -base64 32
ENCRYPTION_KEY=""

# ---- TraderDebate(單一人格交易分析) ----
# 兩個都缺一不可,缺任一個時 /api/trades/[id]/analyze 會回 503,前端顯示
# 「AI 分析尚未開放」且不扣 Credit——不是壞掉,是還沒設定。
# 模型選定見 TradeMind_TraderDebate_單一人格分析Prompt設計.md 第七節:
# 用 Claude Sonnet 量級,不要用 Haiku 量級(格式可靠度/輸出品質實測有差,
# 不是省錢考量,見同文件的實測記錄)。
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""

# ---- 綠界 ECPay(Credit 儲值金流) ----
# 不設定的話會 fallback 到綠界官方公開的測試特店資料,本機開發不用先申請
# 帳號就能跑通 checkout→callback 整條流程。正式上線前必須換成真實特約商店
# 資料,否則收不到真的錢(lib/ecpay.ts 在 NODE_ENV=production 仍用測試資料
# 時會印警告)。
ECPAY_ENV="Test"
ECPAY_MERCHANT_ID=""
ECPAY_HASH_KEY=""
ECPAY_HASH_IV=""

# ---- Sentry(錯誤監控) ----
# 不設定的話 Sentry SDK 會自動靜默停用,本機開發不受影響。
# 到 sentry.io 建一個免費專案後,Client Keys (DSN) 頁面可以拿到這個值。
NEXT_PUBLIC_SENTRY_DSN=""
# 以下三個只在正式建置要上傳 source map(讓錯誤堆疊看得懂原始檔名/行號)時才需要,
# 沒設定的話 build 照樣成功,只是 Sentry 後台看到的錯誤堆疊會是打包後的壓縮程式碼。
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
